// The visit counter: counts each visit in D1 and posts it to Discord.
// The top level is local development; `env.production` is how the deploy
// would differ (wrangler deploy --env production).
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "haoyan-analytics",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-23",
    // Plain HTTP on loopback: browsers reach it through the site's dev
    // server (history:dev), at /__visits/. Not wrangler's usual 8787, which
    // other Workers here use.
    "dev": {
        "ip": "127.0.0.1",
        "port": 8788,
        "local_protocol": "http",
    },
    // Development takes visits from any origin
    "vars": {
        "ENVIRONMENT": "development",
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "haoyan-analytics",
            // wrangler dev counts in a local copy, so testing never moves
            // the live visitor numbers; it needs no real id
            "database_id": "00000000-0000-0000-0000-000000000000",
        },
    ],
    "env": {
        "production": {
            "name": "haoyan-analytics",
            "vars": {
                "ENVIRONMENT": "production",
                "ALLOWED_ORIGIN": "https://haoyan.ca",
            },
            // Bindings aren't inherited, so the database is named again,
            // with the id `wrangler d1 create haoyan-analytics` gave
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "haoyan-analytics",
                    "database_id": "d825a9f9-c78b-4c0a-8932-c80732329fba",
                },
            ],
        },
    },
}
